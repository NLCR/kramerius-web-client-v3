      "provider": "ga4",
      "enabled": true,
      "measurementId": "G-XXXXXXXXXX"
    },
    "googleMaps": {
      "enabled": true,
      "apiKey": "AIzaSyCGDIOYeh5bw_vsBcZxZH3GOzmA0aetqBw"
    }
  },
  "features": {
    "keycloak": true,
    "mapSearch": true,
    "mapProvider": "allmaps",
